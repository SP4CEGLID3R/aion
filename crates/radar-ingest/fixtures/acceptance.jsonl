# Radar Event Protocol v1 — acceptance scenario (synthetic data).
# Lines starting with "#!" are test directives read by tests/acceptance.rs:
#   #! markers: <ids>      the radar must show exactly these markers, now
#   #! advance: <ms>       move the clock forward and run the stale timer
# Other "#" lines are comments. The protocol parser skips every "#" line.
{"v":1,"type":"zone_changed","t":1760000000000,"zone":"fixture-zone"}
{"v":1,"type":"player","t":1760000000000,"pos":[0,0,0],"heading":0,"zone":"fixture-zone"}
#! markers:

# (1) A confirmed spawn adds one marker.
{"v":1,"type":"cube_spawned","t":1760000000100,"id":"cube-1","pos":[10,20,0],"label":"Cube 1"}
#! markers: cube-1

# (5) Duplicate events do not create duplicate markers.
{"v":1,"type":"cube_spawned","t":1760000000100,"id":"cube-1","pos":[10,20,0],"label":"Cube 1"}
{"v":1,"type":"cube_spawned","t":1760000000200,"id":"cube-1","pos":[10,20,0]}
#! markers: cube-1

# (3) A static spawn-point record never creates a marker.
{"v":1,"type":"spawn_point","id":"sp-1","pos":[50,50,0],"label":"Possible spawn"}
#! markers: cube-1

# (4) A historical location never creates a live marker, labelled either way.
{"v":1,"type":"historical_location","t":1759990000000,"id":"cube-0","pos":[-30,5,0]}
{"v":1,"type":"cube_spawned","t":1760000000300,"id":"cube-old","pos":[1,1,0],"provenance":"historical"}
#! markers: cube-1

{"v":1,"type":"cube_spawned","t":1760000000400,"id":"cube-2","pos":[-40,-10,2],"label":"Cube 2"}
{"v":1,"type":"cube_seen","t":1760000001000,"id":"cube-1"}
{"v":1,"type":"cube_seen","t":1760000001000,"id":"cube-2"}
#! markers: cube-1 cube-2

# (2) A confirmed collection removes that marker.
{"v":1,"type":"cube_collected","t":1760000002000,"id":"cube-1"}
#! markers: cube-2

# (6) Missing state: seen but never confirmed spawned, or no id.
{"v":1,"type":"cube_seen","t":1760000002100,"id":"cube-3","pos":[5,5,0]}
{"v":1,"type":"cube_spawned","t":1760000002200,"pos":[7,7,0]}
#! markers: cube-2

# (2) A confirmed despawn removes that marker; a late, older spawn cannot bring it back.
{"v":1,"type":"cube_despawned","t":1760000003000,"id":"cube-2"}
{"v":1,"type":"cube_spawned","t":1760000002900,"id":"cube-2","pos":[-40,-10,2]}
#! markers:

# (6) Stale state: spawned, then no confirmation for longer than the timeout.
{"v":1,"type":"cube_spawned","t":1760000003100,"id":"cube-4","pos":[25,-25,0],"label":"Cube 4"}
{"v":1,"type":"player","t":1760000003100,"pos":[1,1,0],"heading":45}
#! markers: cube-4
#! advance: 10001
#! markers:
